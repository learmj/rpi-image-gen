#!/bin/bash
#
# Give /usr the build's SOURCE_DATE_EPOCH, which identifies the image to units
# with ConditionNeedsUpdate=. The image ships no update stamps, so these units
# run on first boot and systemd-update-done writes the stamps. Late, so nothing
# changes /usr afterwards.

set -eu

fs=$1

[[ -d "$fs" ]] || exit 0

touch -d "@${SOURCE_DATE_EPOCH}" "${fs}/usr"
rm -f "${fs}/etc/.updated" "${fs}/var/.updated"
