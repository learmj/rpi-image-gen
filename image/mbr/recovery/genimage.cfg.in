image <IMAGE_NAME>.img.sparse {
   android-sparse {
      image = <IMAGE_NAME>.img
   }
}

image boot.vfat.sparse {
   android-sparse {
      image = <IMAGE_NAME>.vfat
   }
}

image <IMAGE_NAME>.img {
   hdimage {
      align = 1M
      partition-table-type = "mbr"
      fill = true
      disk-signature = random
   }

   partition boot {
      in-partition-table = true
      partition-type = 0xC
      image = <IMAGE_NAME>.vfat
      bootable = true
   }
}

image <IMAGE_NAME>.vfat {
   vfat {
      label = "BOOT"
   }
   size = 100%
   mountpoint = "/bootfs"
}
